<?xml version="1.0"?>

<launch>
    <!--パラメーターファイル-->
    <arg name="param_file" default="$(find expo_fix2xyz)/config/fix2xyz_default.yaml" />

    <!--ノード名-->
    <arg name="name" default="expo_fix2xyz" />
    
    <arg name="output_option" default="screen" />
    
    <node pkg="expo_fix2xyz" type="expo_fix2xyz" name="$(arg name)" output="$(arg output_option)">
            <rosparam command="load" file="$(arg param_file)"/>
    </node>
    
    
       
</launch>
